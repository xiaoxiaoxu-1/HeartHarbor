/* pages/profile/profile.wxss */
.profile-container {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

/* 用户头部样式 */
.user-header {
	background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
	border-radius: 20rpx;
	padding: 40rpx 30rpx;
	margin-bottom: 30rpx;
	color: white;
}

.user-avatar-section {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.user-avatar {
	width: 120rpx;
	height: 120rpx;
	border-radius: 50%;
	border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.user-info {
	flex: 1;
	margin-left: 30rpx;
}

.user-name {
	font-size: 36rpx;
	font-weight: bold;
	display: block;
	margin-bottom: 10rpx;
}

.user-id {
	font-size: 24rpx;
	opacity: 0.8;
}

.edit-btn {
	background: rgba(255, 255, 255, 0.2);
	padding: 10rpx 20rpx;
	border-radius: 20rpx;
	border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.edit-text {
	font-size: 24rpx;
}

/* 统计信息样式 */
.stats-section {
	display: flex;
	justify-content: space-around;
	background: white;
	border-radius: 20rpx;
	padding: 30rpx 0;
	margin-bottom: 30rpx;
	box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
	text-align: center;
	flex: 1;
}

.stat-number {
	font-size: 36rpx;
	font-weight: bold;
	color: #333;
	display: block;
	margin-bottom: 10rpx;
}

.stat-label {
	font-size: 24rpx;
	color: #666;
}

/* 菜单样式 */
.menu-section {
	background: white;
	border-radius: 20rpx;
	margin-bottom: 30rpx;
	box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.menu-title {
	font-size: 28rpx;
	font-weight: bold;
	color: #333;
	padding: 30rpx 30rpx 20rpx;
	border-bottom: 1rpx solid #f0f0f0;
}

.menu-list {
	padding: 0 30rpx;
}

.menu-item {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 30rpx 0;
	border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
	border-bottom: none;
}

.menu-item-left {
	display: flex;
	align-items: center;
}

.menu-icon {
	width: 60rpx;
	height: 60rpx;
	border-radius: 12rpx;
	background: #f8f9fa;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-right: 20rpx;
}

.menu-text {
	font-size: 28rpx;
	color: #333;
}

.menu-arrow {
	color: #ccc;
	font-size: 24rpx;
}

/* 退出登录样式 */
.logout-section {
	background: white;
	border-radius: 20rpx;
	padding: 30rpx;
	box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.logout-btn {
	background: #ff4757;
	color: white;
	border: none;
	border-radius: 50rpx;
	padding: 20rpx 0;
	font-size: 28rpx;
	width: 100%;
}

.login-prompt {
	text-align: center;
	padding: 20rpx 0;
}

.prompt-text {
	font-size: 28rpx;
	color: #666;
}

.login-link {
	font-size: 28rpx;
	color: #1890ff;
	margin-left: 10rpx;
}